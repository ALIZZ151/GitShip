# Contoh saja. GitShip TIDAK membaca file .env otomatis.
# Muat sendiri sebelum menjalankan, mis.:  set -a; . ./.env; set +a; gitship
# Token dari environment hanya berlaku untuk sesi ini dan tidak disimpan.
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your-email@example.com
GITHUB_TOKEN=ghp_your_token_here
