{
  "name": "alizz-gitship",
  "version": "3.0.0-rc.1",
  "description": "CLI untuk upload project (folder, ZIP, file) ke GitHub dengan preview dan mode replace/overlay.",
  "type": "module",
  "main": "src/cli/main.js",
  "bin": {
    "gitship": "./bin/gitship.js"
  },
  "scripts": {
    "start": "node bin/gitship.js",
    "check": "node --check bin/gitship.js && for f in $(find src -name \"*.js\"); do node --check $f || exit 1; done",
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "github",
    "deploy",
    "cli",
    "termux",
    "zip",
    "alizz",
    "gitship"
  ],
  "author": "ALIZZ",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "figlet": "^1.8.0",
    "gradient-string": "^3.0.0",
    "ora": "^8.2.0"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    ".env.example"
  ]
}
